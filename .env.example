# Slurm REST API 配置
SLURM_REST_URL=http://<slurmrestd-host>:6820
SLURM_API_VERSION=v0.0.37
SLURM_USER_NAME=<slurm-user>
SLURM_USER_TOKEN=your_jwt_token_here

# SSH 配置（用于 sacct/squeue/sinfo 登录节点）
SSH_HOST=<login-node-host>
SSH_PORT=22
SSH_USER=<ssh-user>
SSH_PASSWORD=your_ssh_password_here
# 可选：使用 SSH 密钥替代密码
# SSH_KEY_PATH=/path/to/private/key

# 算力节点 SSH 默认认证信息（节点 IP 在 Web UI 的「集群配置」页管理，存数据库）
# 新增节点时 Web UI 以下面的值预填，可按节点单独修改
NODE_SSH_USER=<node-ssh-user>
NODE_SSH_PASSWORD=your_node_ssh_password_here

# 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slurm_monitor
POSTGRES_USER=slurm_monitor
POSTGRES_PASSWORD=your_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 采集配置
# 实时数据采集间隔（秒）
COLLECTOR_INTERVAL_REALTIME=30
# 历史数据同步间隔（秒）
COLLECTOR_INTERVAL_HISTORY=300
# 历史数据回溯时间（秒）
COLLECTOR_HISTORY_LOOKBACK=3600

# Web 管理员账号（「集群配置」页的登录凭据，强烈建议修改默认值）
ADMIN_USER=admin
ADMIN_PASS=admin123

# 数据目录（可选，默认使用 deploy/pgdata 和 deploy/redisdata）
# 在数据单独挂载到其他路径时设置（如 /data/pgdata）
# PGDATA_DIR=/data/pgdata
# REDISDATA_DIR=/data/redisdata

# 基础镜像（可选，新机器如已有对应镜像可在此覆盖）
# PG_IMAGE=postgres:16
# REDIS_IMAGE=redis:7-alpine

# Web 服务配置
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/slurm-monitor/app.log

# 时区配置
TIMEZONE=Asia/Shanghai
